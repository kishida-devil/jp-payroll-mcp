{
  "name": "jp-payroll-mcp",
  "version": "0.4.4",
  "description": "日本の給与計算・社会保険・労務のMCPサーバー。Japanese payroll, social insurance and labour law for AI assistants and HTTP clients: 47都道府県の保険料率、源泉徴収税額表、割増賃金、年次有給休暇、標準報酬月額の定時決定・随時改定、産休育休の保険料免除、最低賃金、消費税率。公表資料から計算し、根拠にした条文を必ず添えます。協会けんぽ・国税庁の公式表に一桁ずつ照合済み。社労士・人事労務の実務向け。",
  "type": "module",
  "bin": {
    "jp-payroll-mcp": "src/index.mjs"
  },
  "main": "src/index.mjs",
  "files": [
    "src",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node test/smoke.mjs && node test/failure.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:failure": "node test/failure.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "japan",
    "japanese",
    "payroll",
    "hr",
    "social-insurance",
    "labor-law",
    "law",
    "e-gov",
    "sharoushi",
    "nenkin",
    "shakai-hoken",
    "withholding-tax",
    "minimum-wage",
    "kyuyo",
    "roumu",
    "社会保険",
    "給与計算",
    "標準報酬月額",
    "源泉徴収",
    "社労士",
    "労務",
    "年金",
    "法令",
    "overtime",
    "annual-leave",
    "consumption-tax",
    "invoice",
    "corporate-number"
  ],
  "author": "tsumugi",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "homepage": "https://github.com/kishida-devil/jp-payroll-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kishida-devil/jp-payroll-mcp.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/kishida-devil/jp-payroll-mcp/issues"
  },
  "mcpName": "io.github.kishida-devil/jp-payroll-mcp"
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japan-payroll-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // 無料枠(直接アクセス・MCP経由)のレート制限。RapidAPI経由は向こうが課金と
  // クォータを持つので素通しする。period は 10 か 60 しか取れない。
  "ratelimits": [
    {
      "name": "FREE_TIER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
}
